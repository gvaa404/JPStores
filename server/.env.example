PORT=4000
JWT_SECRET=jp-store-change-this-secret

# Razorpay Payment Gateway (Test or Live credentials)
# Obtain from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Resend Primary Email Service
# Obtain API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=JP Store <onboarding@resend.dev>

# Gmail SMTP Fallback
# Requires Gmail Address and 16-digit App Password from https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password

# Frontend base URL for email links
APP_URL=http://localhost:5173
